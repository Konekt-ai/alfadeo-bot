# ===== WhatsApp Cloud API (Meta Graph API) =====
# Token permanente (System User) o temporal de la app de Meta
WHATSAPP_TOKEN=
# ID del número de teléfono (Phone Number ID), NO el número visible
WHATSAPP_PHONE_NUMBER_ID=
# Token que tú inventas y registras en Meta para verificar el webhook (GET /webhook)
WHATSAPP_VERIFY_TOKEN=
# Versión de la Graph API
GRAPH_API_VERSION=v21.0
# Secreto de la app, para comprobar que los webhooks vengan de verdad de Meta.
# Meta for Developers -> tu app -> Configuración -> Básica -> Clave secreta.
# Sin esto, cualquiera que descubra la URL pública puede inventar mensajes.
META_APP_SECRET=

# ===== Base de datos =====
# PostgreSQL corre en la MISMA computadora que el bot. No hay nube, y la base
# escucha sólo en localhost: nada de esto sale a internet.
# El usuario `bot` lo crea sql/rol-bot.sql y sólo alcanza lo que el bot
# necesita. NO pongas aquí el usuario `alfadeo` que usa el panel.
DATABASE_URL=postgresql://bot:CONTRASENA@localhost:5433/alfadeo

# ===== Equipo interno =====
# Respaldo: estos números reciben TODAS las solicitudes, sin importar la plaza.
# Formato internacional sin '+', separados por coma. Ej: 5213312345678,5213398765432
INTERNAL_NOTIFY_NUMBERS=

# ===== Ruteo por sucursal (minuta 15) =====
# Cada solicitud se manda al asesor de la plaza que le toca.
# Formato: CLAVE:numero,CLAVE:numero
RUTEO_ASESORES=GDL:5213312345678,MTY:5218112345678
# Plaza que atiende cuando no hay pistas de ciudad ni de existencia.
SUCURSAL_DEFAULT=GDL

# ===== Qué contesta el bot solo =====
# Existencia real (sí/no) consultando inventario. Minuta 2.
BOT_DA_EXISTENCIA=true
# Piezas exactas. APAGADO a propósito: expondría tu nivel de inventario
# a cualquiera que escriba al WhatsApp.
BOT_DA_CANTIDADES=false
# Precio automático. APAGADO a propósito: el precio B2B depende de tipo de
# cliente y volumen, siempre lo confirma un asesor.
BOT_DA_PRECIOS=false

# ===== Logística y tiempos de entrega (minuta 5) =====
PAQUETERIA=DHL
# Hora (0-23) después de la cual el pedido ya sale hasta el día siguiente.
ENTREGA_HORA_CORTE=15
# Días hábiles extra cuando el producto hay que pedirlo a proveedor.
ENTREGA_DIAS_PROVEEDOR=2
ZONA_HORARIA=America/Mexico_City

# ===== Reglas de negocio =====
# Piezas a partir de las cuales la solicitud pasa a una persona.
ESCALA_CANTIDAD_UMBRAL=500

# ===== Servidor =====
# Puerto local del webhook. El panel ya ocupa el 3002 en esa computadora.
PORT=3000
